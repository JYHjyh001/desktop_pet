{
  "name": "pet-drawer",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "check:icons": "powershell -ExecutionPolicy Bypass -File scripts/create-icon.ps1",
    "create-icon": "npm run check:icons",
    "pretauri:dev": "npm run check:icons",
    "pretauri:build": "npm run check:icons",
    "dev": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "vue-tsc --noEmit",
    "test:frontend": "vitest run",
    "build:frontend": "vite build",
    "build": "npm run typecheck && npm run build:frontend",
    "check:privacy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-privacy.ps1",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:ci": "npm run check:privacy && npm run check:icons && npm run typecheck && npm run test:frontend && npm run build:frontend && npm run check:rust:fmt && npm run check:rust && npm run test:rust && npm run lint:rust",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "three": "^0.185.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.0.0"
  }
}
