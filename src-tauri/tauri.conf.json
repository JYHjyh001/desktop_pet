{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PetDrawer",
  "version": "0.3.1",
  "identifier": "com.petdrawer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "pet",
        "title": "PetDrawer",
        "width": 160,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "pet-bubble",
        "title": "PetDrawer Bubble",
        "width": 300,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "drawer",
        "title": "PetDrawer Drawer",
        "width": 900,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "pet-menu",
        "title": "PetDrawer Menu",
        "width": 168,
        "height": 276,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "pet-chat",
        "title": "PetDrawer Chat",
        "width": 380,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "story",
        "title": "PetDrawer Story",
        "width": 900,
        "height": 680,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "music",
        "title": "PetDrawer Music",
        "width": 520,
        "height": 740,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
