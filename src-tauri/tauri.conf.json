{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PetDrawer",
  "version": "0.1.0",
  "identifier": "com.petdrawer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "pet",
        "title": "PetDrawer",
        "width": 132,
        "height": 132,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "drawer",
        "title": "PetDrawer Drawer",
        "width": 760,
        "height": 540,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "pet-menu",
        "title": "PetDrawer Menu",
        "width": 132,
        "height": 132,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
